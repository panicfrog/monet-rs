# Rust — the build tree. Cargo.lock stays TRACKED (committed for
# reproducible builds since the first commit).
/target/
**/*.rs.bk
Cargo.lock.bak

# Swift / Xcode (monet-urlsession's cxx artifacts land under target/, but
# local experiments shouldn't leak either)
DerivedData/
.build/
xcuserdata/
*.xcarchive/
*.xcodeproj/
# ...except the RN demo app's Xcode project — it is source, not a local
# experiment. Re-include the directory first, then its contents (gitignore
# cannot re-include files under an excluded directory).
!platform/rn-demo/ios/MonetDemo.xcodeproj/
!platform/rn-demo/ios/MonetDemo.xcodeproj/**

# Gradle / Android (platform/android-demo)
.gradle/
build/
**/jniLibs/
local.properties
captures/
.externalNativeBuild/
.cxx/
obj/
*.apk
*.aab
*.hprof

# IDE
.idea/
*.iml
.vscode/

# macOS / editor noise
.DS_Store
*.swp
